<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="figura geometrica"/>
        <attribute name="authors" value="murie"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-04-30 07:30:20 p.&#8239;m."/>
        <attribute name="created" value="bXVyaWU7TEFQVE9QLU42Tzc1RlFQOzIwMjYtMDQtMzA7MDc6MTI6MzcgcC7igK9tLjsxMTI4MQ=="/>
        <attribute name="edited" value="bXVyaWU7TEFQVE9QLU42Tzc1RlFQOzIwMjYtMDQtMzA7MDc6MzA6MjAgcC7igK9tLjsxOzExMzgx"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="i, cantidad, j" type="Integer" array="False" size=""/>
            <input variable="cantidad"/>
            <for variable="j" start="1" end="cantidad" direction="inc" step="1">
                <for variable="i" start="1" end="cantidad" direction="inc" step="1">
                    <forward expression="100" pen="down"/>
                    <turn expression="360/cantidad" rotate="right"/>
                </for>
                <forward expression="100" pen="down"/>
                <turn expression="360/cantidad" rotate="left"/>
            </for>
        </body>
    </function>
</flowgorithm>
