    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="AT, AC, T, A, B, C" type="Real" array="False" size=""/>
            <input variable="A"/>
            <input variable="B"/>
            <input variable="C"/>
            <assign variable="T" expression="(A-C)*B/2+(C*B)"/>
            <output expression="T" newline="True"/>
        </body>
    </function>
